# Salin file ini menjadi .env lalu isi nilainya.
# Jangan bagikan file .env ke siapa pun — isinya rahasia.

# Token akses WhatsApp dari Meta Developers (lihat README langkah 2)
WHATSAPP_TOKEN=
# ID nomor WhatsApp Business (dari Meta Developers)
PHONE_NUMBER_ID=
# Token verifikasi webhook — kamu yang tentukan, bebas, mis. rahasia123
VERIFY_TOKEN=rahasia123
# Kunci API model AI (OpenAI). Kosong = MOCK MODE (jawaban dari FAQ/produk saja)
OPENAI_API_KEY=
# Boleh ganti model / provider yang kompatibel OpenAI (mis. Groq / OpenRouter)
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
# Port server lokal
PORT=8000
